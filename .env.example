# Backend-only OpenAI configuration. Never prefix secrets with VITE_.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o

# Optional bounded automation settings.
IRIS_WATCH_TIMEOUT_SECONDS=300
IRIS_WATCH_INTERVAL_SECONDS=3
IRIS_RATE_LIMIT_REQUESTS=120
IRIS_VISION_DEBUG=0

# Public renderer configuration; contains no secret.
VITE_IRIS_BACKEND_URL=http://127.0.0.1:8000
IRIS_BACKEND_URL=http://127.0.0.1:8000
IRIS_UI_URL=http://localhost:5173
IRIS_ACTIVITY_GATEWAY_PORT=32000
IRIS_BROWSER_CDP_URL=http://127.0.0.1:9222
IRIS_PARALLEL_CDP_URL=http://127.0.0.1:9223
