{
  "manifest_version": 3,
  "key": "",
  "name": "IRIS Activity Gateway",
  "version": "1.0.0",
  "description": "Streams active Chrome tab URLs directly into the IRIS Cognitive Timeline.",
  "permissions": [
    "tabs",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1:32000/*"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
