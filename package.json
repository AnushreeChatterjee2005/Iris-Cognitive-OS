{
  "name": "hackathon-iris",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "start": "concurrently --kill-others-on-fail \"npm run backend\" \"npm run dev\"",
    "backend": "cd iris_core && python -u -m uvicorn main:app --host 127.0.0.1 --port 8000 --log-level warning",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test:gateway": "node --experimental-strip-types --test electron/engine/activityValidation.test.mjs",
    "test:python": "python -m pytest -q",
    "test": "npm run test:gateway && npm run test:python",
    "check": "npm run lint && npm run build && npm test",
    "preview": "vite preview",
    "electron:dev": "wait-on http://localhost:5173 && electron ."
  },
  "dependencies": {
    "lucide-react": "^1.17.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.17.0",
    "sql.js": "^1.14.1",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/sql.js": "^1.4.11",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "electron": "^42.4.0",
    "electron-builder": "^26.15.2",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vite-plugin-electron": "^1.0.4",
    "vite-plugin-electron-renderer": "^1.0.0",
    "wait-on": "^9.0.10"
  }
}
